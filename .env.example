# Copy to .env in the project root and adjust. Everything has a sensible default for local development.

NODE_ENV=development
PORT=3001

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origin allowed by CORS (only matters if the client is served from a different origin)
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty locally: a SQLite file is created automatically.
# For production use a free hosted Postgres such as Neon (https://neon.tech):
#   DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# SQLITE_PATH=./server/data/postboard.sqlite

# --- Optional: AI thread summaries (leave empty to hide the feature) ---------
# Free option: any OpenAI-compatible API with a free tier. Check each provider's current limits.
#   Groq (default):   AI_BASE_URL=https://api.groq.com/openai/v1               AI_MODEL=llama-3.3-70b-versatile
#   Google Gemini:    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
#   OpenRouter:       AI_BASE_URL=https://openrouter.ai/api/v1                  AI_MODEL=<a model marked :free>
AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# Paid alternative: ANTHROPIC_API_KEY=  (model via ANTHROPIC_MODEL, default claude-haiku-5-5)
